+#ifndef PS2_ANDROID_INPUT_H
+#define PS2_ANDROID_INPUT_H
+
+// Port-SotC-Mobile (D18): on-screen controls for the Android runner.
+//
+// The runner is a raylib NativeActivity, so Android hands the touches to
+// raylib's native_app_glue loop and raylib fills CORE.Input.Touch from every
+// motion event. This module samples those points once per host frame on the
+// render thread, publishes a pad state the EE thread reads at each VBlank,
+// and draws the overlay into the same GL frame as the game picture. The
+// Kotlin overlay belongs to the ABI-v1 diagnostics host and never sees the
+// runner's window, which is why the gameplay overlay lives here.
+//
+// Only built on Android: ps2_pad.cpp and ps2_runtime.cpp include this header
+// and guard every call with #if defined(__ANDROID__).
+
+#include <cstdint>
+
+namespace ps2_android_input
+{
+    // Logical controls. The pad backend maps them to its PS2 wire bits, so
+    // the wire format stays in ps2_pad.cpp only.
+    enum class Button : unsigned
+    {
+        Up,
+        Down,
+        Left,
+        Right,
+        Cross,
+        Circle,
+        Square,
+        Triangle,
+        L1,
+        L2,
+        R1,
+        R2,
+        Start,
+        Select,
+        L3,
+        R3,
+        Count
+    };
+
+    inline unsigned buttonBit(Button button) { return 1u << static_cast<unsigned>(button); }
+
+    struct State
+    {
+        unsigned buttons = 0;   // bit i: Button(i) held this frame
+        float leftX = 0.0f;     // -1..1, right positive (screen axes)
+        float leftY = 0.0f;     // -1..1, down positive
+        float rightX = 0.0f;    // after the look sensitivity / inversion knobs
+        float rightY = 0.0f;
+        bool leftStick = false; // a finger owns the left stick
+        bool rightStick = false;
+        bool visible = false;   // the overlay is on screen this frame
+    };
+
+    // Samples the touch points and republishes the state. Render thread,
+    // once per host frame, before the pad can be read for that frame.
+    void update();
+
+    // The last published state. Any thread: PSPadBackend::readState calls it
+    // from the EE thread at each VBlank.
+    State state();
+
+    // Draws the overlay. Render thread, between BeginDrawing/EndDrawing.
+    void drawOverlay();
+}
+
+#endif // PS2_ANDROID_INPUT_H
