+    drawPad(layout.l1, "L1", owned(Button::L1));
+    drawPad(layout.l2, "L2", owned(Button::L2));
+    drawPad(layout.r1, "R1", owned(Button::R1));
+    drawPad(layout.r2, "R2", owned(Button::R2));
+    drawPad(layout.select, "SELECT", owned(Button::Select));
+    drawPad(layout.start, "START", owned(Button::Start));
+}
