 #include <cstdio>
 #include <cstdlib>
 
+// Port-SotC-Mobile (D18): app-authoritative pacing on Android. The settings
+// screen publishes these values before the runner loads, so every reader is a
+// startup-cached static. The guest time step is never modified here.
+namespace sotc_pacing
+{
+    static bool hasFrameLimit()
+    {
+        static const bool value = std::getenv("SOTC_FRAME_LIMIT") != nullptr;
+        return value;
+    }
+
+    static int frameLimit()
+    {
+        static const int value = []
+        {
+            const char *env = std::getenv("SOTC_FRAME_LIMIT");
+            const int parsed = env ? std::atoi(env) : 60;
+            const int accepted = (parsed == 0 || parsed == 30 || parsed == 60) ? parsed : 60;
+            std::fprintf(stderr, "[pace] SOTC_FRAME_LIMIT=%s -> %d\n", env ? env : "(unset)", accepted);
+            return accepted;
+        }();
+        return value;
+    }
+
+    static bool adaptive()
+    {
+        static const bool value = std::getenv("SOTC_ADAPTIVE_RESOLUTION") == nullptr ||
+                                  std::atoi(std::getenv("SOTC_ADAPTIVE_RESOLUTION")) != 0;
+        return value;
+    }
+
+    static bool scaleCycle()
+    {
+        static const bool value = std::getenv("SOTC_SCALE_CYCLE") != nullptr;
+        return value;
+    }
+
+    std::atomic<int> g_targetFps{60};
+
+    // Mirrors the host engine's adaptive-resolution contract in runner units:
+    // 5% steps, 0.75 s cadence, 1.20x/0.75x thresholds. Only the runner writes
+    // its own render scale; the host EGL surface is never resized for this.
+    static void adapt(float frameMs, double now)
+    {
+        if (!adaptive() || scaleCycle() || frameMs <= 0.0f)
+            return;
+
+        float &scale = native_renderer::tuning().renderScale;
+        static float ceiling = scale;
+        static float previous = scale;
+        static double lastChange = now;
+        static float smoothedMs = frameMs;
+        static bool initialized = false;
+
+        if (!initialized)
+        {
+            initialized = true;
+            ceiling = scale;
+            previous = scale;
+            lastChange = now;
+            smoothedMs = frameMs;
+            const float floor = std::max(0.5f, ceiling * 0.5f);
+            std::fprintf(stderr, "[scale-adaptive] on: ceiling=%.3f floor=%.3f\n", ceiling, floor);
+            return;
+        }
+
+        if (previous != scale)
+        {
+            // The menu, a preset or a failed recreation already changed it.
+            ceiling = scale;
+            previous = scale;
+            lastChange = now;
+            smoothedMs = frameMs;
+            return;
+        }
+
+        constexpr float kMinScale = 0.5f;
+        constexpr float kStep = 0.05f;
+        const float floor = std::max(kMinScale, ceiling * 0.5f);
+        const float budget = 1000.0f / static_cast<float>(frameLimit() > 0 ? frameLimit() : 60);
+        smoothedMs += (frameMs - smoothedMs) * 0.1f;
+
+        if (now - lastChange < 0.75)
+            return;
+
+        float next = scale;
+        if (smoothedMs > budget * 1.20f && scale > floor)
+            next = std::max(floor, scale - kStep);
+        else if (smoothedMs < budget * 0.75f && scale < ceiling)
+            next = std::min(ceiling, scale + kStep);
+
+        if (next != scale)
+        {
+            scale = next;
+            previous = next;
+            smoothedMs = frameMs;
+            lastChange = now;
+            std::fprintf(stderr, "[scale-adaptive] frame %llu: render scale %.3f\n",
+                         static_cast<unsigned long long>(ps2_stats::vblanks.load(std::memory_order_relaxed)), scale);
+        }
+    }
+}
