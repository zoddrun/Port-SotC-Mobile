+#ifndef PS2X_RUNTIME_SOTC_HD_SHADER_H
+#define PS2X_RUNTIME_SOTC_HD_SHADER_H
+
+// Port-SotC-Mobile (patch 0011): optional full-screen HD shader pass for the
+// raylib-owned game picture. The pass is loaded from the verified shader pack
+// installed by the app and is wrapped around the game-picture DrawTexturePro
+// only, so FPS text, debug UI, menus and the Android touch overlay remain
+// untouched by post-processing.
+//
+// The module is a no-op unless SOTC_HD_SHADER_PACK names an installed pack.
+// All calls are safe on the render thread after InitWindow has created raylib's
+// GL context; initialize() is idempotent and must be called once before the
+// frame loop.
+
+#include "raylib.h"
+
+namespace sotc_hd_shader
+{
+    // Reads the pack environment, rewrites the ES 1.00 assets for raylib's
+    // batching contract and compiles them. Failures are logged with a clear
+    // [hd-shader] line and leave the module disabled.
+    void initialize();
+
+    // True only when a custom program compiled and its custom uniform was
+    // found. LoadShaderFromMemory silently falls back to raylib's default
+    // shader on compile/link failure, so this is a real check, not a guess.
+    bool enabled();
+
+    // Returns the custom Shader when enabled, otherwise an empty Shader.
+    // Callers must check enabled() before using the result.
+    Shader shader();
+
+    // Applies the pack's uniform values and enters shader mode for the game
+    // picture. width/height are the source texture dimensions in pixels.
+    void begin(int width, int height);
+
+    // Restores raylib's default shader. Safe when disabled.
+    void end();
+
+    // Emits one [hd-shader] telemetry line in the existing PS2X_STATS block.
+    // The [pace] record and its field order are never modified.
+    void report();
+}
+
+#endif // PS2X_RUNTIME_SOTC_HD_SHADER_H
