diff --git a/PS2Recomp/ps2xRuntime/src/lib/sotc_hd_shader.cpp b/PS2Recomp/ps2xRuntime/src/lib/sotc_hd_shader.cpp
new file mode 100644
index 0000000..b05bba5
--- /dev/null
+++ b/PS2Recomp/ps2xRuntime/src/lib/sotc_hd_shader.cpp
@@ -0,0 +1,332 @@
+#include "runtime/sotc_hd_shader.h"
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+namespace sotc_hd_shader
+{
+namespace
+{
+    struct PresetValues
+    {
+        float sharpness;
+        float bloom;
+        float fxaa;
+    };
+
+    struct State
+    {
+        bool attempted = false;
+        bool enabled = false;
+        bool compiled = false;
+        bool loaded = false;
+        std::string preset = "balanced";
+        std::string version = "unknown";
+        std::string reason = "not-initialized";
+        std::string detail;
+        Shader shader{};
+        int texelLocation = -1;
+        int sharpnessLocation = -1;
+        int bloomLocation = -1;
+        int fxaaLocation = -1;
+        float texelX = 0.0f;
+        float texelY = 0.0f;
+        PresetValues values{0.0f, 0.0f, 0.0f};
+        unsigned long long frames = 0;
+    };
+
+    State &state()
+    {
+        static State value;
+        return value;
+    }
+
+    void log(const char *format, ...)
+    {
+        va_list args;
+        va_start(args, format);
+        std::fputs("[hd-shader] ", stderr);
+        std::vfprintf(stderr, format, args);
+        va_end(args);
+        std::fputc('\n', stderr);
+        std::fflush(stderr);
+    }
+
+    std::string replaceAll(std::string text, const std::string &from, const std::string &to)
+    {
+        if (from.empty())
+            return text;
+        std::string::size_type at = 0;
+        while ((at = text.find(from, at)) != std::string::npos)
+        {
+            text.replace(at, from.size(), to);
+            at += to.size();
+        }
+        return text;
+    }
+
+    std::string insertAfterVersion(std::string source, const std::string &declaration)
+    {
+        if (source.compare(0, 8, "#version") == 0)
+        {
+            const std::string::size_type newline = source.find('\n');
+            if (newline != std::string::npos)
+            {
+                source.insert(newline + 1, declaration + "\n");
+                return source;
+            }
+        }
+        return declaration + "\n" + source;
+    }
+
+    std::string joinPath(const std::string &directory, const char *name)
+    {
+        if (directory.empty())
+            return name;
+        if (directory.back() == '/' || directory.back() == '\\')
+            return directory + name;
+        return directory + "/" + name;
+    }
+
+    bool readText(const std::string &path, std::string &output, std::string &error)
+    {
+        std::ifstream input(path.c_str(), std::ios::binary);
+        if (!input)
+        {
+            error = "unable to open " + path;
+            return false;
+        }
+        std::ostringstream buffer;
+        buffer << input.rdbuf();
+        output = buffer.str();
+        if (output.empty())
+        {
+            error = "empty file " + path;
+            return false;
+        }
+        return true;
+    }
+
+    PresetValues presetValues(const std::string &preset)
+    {
+        // These are the numeric defaults from sotc_hd_pack.json. The pack's
+        // GLSL keeps its own asset-authored strengths; only these uniforms are
+        // supplied by the runner because the ES 1.00 assets have no defaults.
+        if (preset == "battery")
+            return {0.15f, 0.0f, 0.0f};
+        if (preset == "ultra")
+            return {0.50f, 0.35f, 1.0f};
+        return {0.35f, 0.26f, 1.0f}; // balanced (also the fallback)
+    }
+
+    std::string presetFromEnvironment()
+    {
+        const char *text = std::getenv("SOTC_HD_SHADER_PRESET");
+        if (text && (std::strcmp(text, "battery") == 0 || std::strcmp(text, "ultra") == 0 ||
+                     std::strcmp(text, "balanced") == 0))
+            return text;
+        return "balanced";
+    }
+
+    std::string rewriteVertex(std::string source)
+    {
+        source = replaceAll(source, "attribute vec2 aPos;", "attribute vec3 vertexPosition;");
+        source = replaceAll(source, "attribute vec2 aUv;", "attribute vec2 vertexTexCoord;");
+        source = replaceAll(source, "varying vec2 vUv;", "varying vec2 fragTexCoord;");
+        source = replaceAll(source, "vUv = aUv;", "fragTexCoord = vertexTexCoord;");
+        source = replaceAll(source, "gl_Position = vec4(aPos, 0.0, 1.0);",
+                            "gl_Position = mvp * vec4(vertexPosition, 1.0);");
+        // The installed assets use the exact spellings above; these generic
+        // replacements keep a reindented pack from silently losing a name.
+        source = replaceAll(source, "vUv", "fragTexCoord");
+        source = replaceAll(source, "aUv", "vertexTexCoord");
+        source = replaceAll(source, "aPos", "vertexPosition");
+        if (source.find("uniform mat4 mvp;") == std::string::npos)
+            source = insertAfterVersion(source, "uniform mat4 mvp;");
+
+#if !defined(__ANDROID__)
+        // Host smoke uses raylib's OpenGL 3.3 backend, which needs core GLSL.
+        source = replaceAll(source, "#version 100", "#version 330");
+        source = replaceAll(source, "attribute ", "in ");
+        source = replaceAll(source, "varying ", "out ");
+#endif
+        return source;
+    }
+
+    std::string rewriteFragment(std::string source)
+    {
+#if defined(__ANDROID__)
+        // Android's raylib context is GLES2 / GLSL ES 1.00. "texture" is safe
+        // there and matches the documented pack contract.
+        const char *sampler = "texture";
+#else
+        // "texture" is a built-in function name in GLSL 3.30; raylib 5.5 binds
+        // its batch sampler as "texture0", so use that name on desktop.
+        const char *sampler = "texture0";
+#endif
+        source = replaceAll(source, "uniform sampler2D uSceneTex;",
+                            std::string("uniform sampler2D ") + sampler + ";");
+        source = replaceAll(source, "uSceneTex", sampler);
+        source = replaceAll(source, "varying vec2 vUv;", "varying vec2 fragTexCoord;");
+        source = replaceAll(source, "vUv", "fragTexCoord");
+
+#if defined(__ANDROID__)
+        // Keep raylib 5.5's real sampler name active as an alias: DrawTexturePro
+        // sets texture0 explicitly, while the pack-facing "texture" name stays
+        // in the rewritten source for the documented ES 1.00 contract.
+        source = replaceAll(source, "uniform sampler2D texture;",
+                            "uniform sampler2D texture;\nuniform sampler2D texture0;");
+        source = replaceAll(source, "texture2D(texture,", "texture2D(texture0,");
+#else
+        source = replaceAll(source, "#version 100", "#version 330");
+        source = replaceAll(source, "precision mediump float;", "");
+        source = replaceAll(source, "varying ", "in ");
+        source = insertAfterVersion(source, "out vec4 fragColor;");
+        source = replaceAll(source, "texture2D(", "texture(");
+        source = replaceAll(source, "gl_FragColor", "fragColor");
+#endif
+        return source;
+    }
+
+    void setUniform(const Shader &shader, int location, const void *value, int type)
+    {
+        if (location >= 0)
+            SetShaderValue(shader, location, value, type);
+    }
+
+    void fail(State &value, const char *reason, const std::string &detail)
+    {
+        value.reason = reason;
+        value.detail = detail;
+        log("enabled=0 compiled=0 loaded=0 reason=%s detail=%s", reason, detail.c_str());
+    }
+}
+
+void initialize()
+{
+    State &value = state();
+    if (value.attempted)
+        return;
+    value.attempted = true;
+
+    const char *pack = std::getenv("SOTC_HD_SHADER_PACK");
+    if (pack == nullptr || pack[0] == '\0')
+    {
+        fail(value, "no-pack", "SOTC_HD_SHADER_PACK is unset");
+        return;
+    }
+
+    value.preset = presetFromEnvironment();
+    const char *version = std::getenv("SOTC_HD_SHADER_VERSION");
+    if (version != nullptr && version[0] != '\0')
+        value.version = version;
+    value.values = presetValues(value.preset);
+
+    std::string vertexPath = joinPath(pack, "sotc_hd_es2.vert");
+    std::string fragmentPath = joinPath(pack, "sotc_hd_es2.frag");
+    std::string vertexSource;
+    std::string fragmentSource;
+    std::string error;
+    if (!readText(vertexPath, vertexSource, error) || !readText(fragmentPath, fragmentSource, error))
+    {
+        fail(value, "read-failed", error);
+        return;
+    }
+    if (vertexSource.find("#version 100") == std::string::npos ||
+        fragmentSource.find("#version 100") == std::string::npos)
+    {
+        fail(value, "not-es2-source", "expected GLSL ES 1.00 assets in " + std::string(pack));
+        return;
+    }
+
+    const std::string vertex = rewriteVertex(vertexSource);
+    const std::string fragment = rewriteFragment(fragmentSource);
+    value.shader = LoadShaderFromMemory(vertex.c_str(), fragment.c_str());
+
+    // LoadShaderFromMemory falls back to the default shader on compile/link
+    // failure. A custom uniform is the honest proof that our program is bound.
+    value.sharpnessLocation = GetShaderLocation(value.shader, "uSharpness");
+    value.bloomLocation = GetShaderLocation(value.shader, "uBloomIntensity");
+    value.fxaaLocation = GetShaderLocation(value.shader, "uFxaaStrength");
+    value.texelLocation = GetShaderLocation(value.shader, "uTexelSize");
+    if (value.sharpnessLocation < 0 || value.texelLocation < 0)
+    {
+        fail(value, "compile-failed", "custom uniform uSharpness/uTexelSize is absent");
+        return;
+    }
+
+    value.compiled = true;
+    value.loaded = true;
+    value.enabled = true;
+    value.reason = "ok";
+    value.detail = "custom-uniform-ok";
+#if defined(__ANDROID__)
+    const char *backend = "es2";
+#else
+    const char *backend = "gl330";
+#endif
+    log("enabled=1 compiled=1 loaded=1 backend=%s preset=%s version=%s "
+        "sharpness=%.2f bloom=%.2f fxaa=%.2f detail=custom-uniform-ok",
+        backend, value.preset.c_str(), value.version.c_str(), value.values.sharpness,
+        value.values.bloom, value.values.fxaa);
+}
+
+bool enabled()
+{
+    return state().enabled;
+}
+
+Shader shader()
+{
+    State &value = state();
+    return value.enabled ? value.shader : Shader{};
+}
+
+void begin(int width, int height)
+{
+    State &value = state();
+    if (!value.enabled)
+        return;
+
+    // Uniforms are uploaded only after BeginShaderMode makes our program the
+    // current one. glUniform* on the default program would be a silent no-op.
+    BeginShaderMode(value.shader);
+    value.texelX = width > 0 ? 1.0f / static_cast<float>(width) : 0.0f;
+    value.texelY = height > 0 ? 1.0f / static_cast<float>(height) : 0.0f;
+    const Vector2 texel{value.texelX, value.texelY};
+    setUniform(value.shader, value.texelLocation, &texel, SHADER_UNIFORM_VEC2);
+    setUniform(value.shader, value.sharpnessLocation, &value.values.sharpness, SHADER_UNIFORM_FLOAT);
+    setUniform(value.shader, value.bloomLocation, &value.values.bloom, SHADER_UNIFORM_FLOAT);
+    setUniform(value.shader, value.fxaaLocation, &value.values.fxaa, SHADER_UNIFORM_FLOAT);
+    ++value.frames;
+}
+
+void end()
+{
+    if (state().enabled)
+        EndShaderMode();
+}
+
+void report()
+{
+    State &value = state();
+    if (!value.attempted)
+        initialize();
+#if defined(__ANDROID__)
+    const char *backend = "es2";
+#else
+    const char *backend = "gl330";
+#endif
+    log("enabled=%d compiled=%d loaded=%d backend=%s preset=%s version=%s "
+        "sharpness=%.2f bloom=%.2f fxaa=%.2f texel=%.5f,%.5f frames=%llu reason=%s",
+        value.enabled ? 1 : 0, value.compiled ? 1 : 0, value.loaded ? 1 : 0,
+        backend, value.preset.c_str(), value.version.c_str(), value.values.sharpness,
+        value.values.bloom, value.values.fxaa, value.texelX, value.texelY,
+        value.frames, value.reason.c_str());
+}
+}
