<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_atmosphere"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            style="@style/Text.Subtitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_title"
            style="@style/Text.Title" />

        <View
            android:layout_width="48dp"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/bone_gold_dim" />

        <LinearLayout
            android:id="@+id/status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_not_imported"
                android:textColor="@color/parchment"
                android:textSize="17sp"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ash"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <Button
            android:id="@+id/button_play"
            style="@style/Widget.ActionButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/play" />

        <Button
            android:id="@+id/button_import"
            style="@style/Widget.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/import_game" />

        <Button
            android:id="@+id/button_settings"
            style="@style/Widget.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/settings" />

        <Button
            android:id="@+id/button_controller"
            style="@style/Widget.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/controller" />

        <Button
            android:id="@+id/button_diagnostics"
            style="@style/Widget.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/diagnostics" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/legal_notice"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/build_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>
