<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_atmosphere"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="56dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_wordmark"
            style="@style/Text.Wordmark" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/bone_gold_dim" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_title"
            style="@style/Text.Subtitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:letterSpacing="0.18" />

        <LinearLayout
            android:id="@+id/status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_not_imported"
                android:textColor="@color/parchment"
                android:textSize="17sp"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/status_detail_not_imported"
                android:textColor="@color/ash"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/status_serial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hd_pack_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hd_pack_title"
                android:textColor="@color/bone_gold"
                android:textSize="11sp"
                android:letterSpacing="0.18" />

            <TextView
                android:id="@+id/hd_status_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hd_pack_missing"
                android:textColor="@color/parchment"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hd_status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ash"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hd_status_preset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/button_hd_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/hd_pack_open_settings"
                android:textColor="@color/bone_gold"
                android:textSize="11sp"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <Button
            android:id="@+id/button_play"
            style="@style/Widget.ActionButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="26dp"
            android:text="@string/play" />

        <TextView
            android:id="@+id/play_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/play_hint_not_imported"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/button_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/view_details"
            android:textColor="@color/bone_gold"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_import"
                style="@style/Widget.ActionButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/import_game" />

            <Button
                android:id="@+id/button_settings"
                style="@style/Widget.ActionButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/settings" />
        </LinearLayout>

        <Button
            android:id="@+id/button_controller"
            style="@style/Widget.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="@string/controller" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/legal_notice"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/build_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>
