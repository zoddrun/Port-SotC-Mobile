<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black">

    <com.portsotc.mobile.nativebridge.NativeSurfaceView
        android:id="@+id/native_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.portsotc.mobile.input.TouchControllerView
        android:id="@+id/touch_controller"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/game_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:background="@color/scrim"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:textColor="@color/bone_gold"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <TextView
        android:id="@+id/game_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="76dp"
        android:layout_marginTop="16dp"
        android:background="@color/scrim"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/ash"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/button_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:background="@color/scrim"
        android:contentDescription="@string/pause_title"
        android:padding="12dp"
        android:src="@android:drawable/ic_media_pause"
        android:tint="@color/parchment" />

    <LinearLayout
        android:id="@+id/pause_panel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pause_title"
            style="@style/Text.Subtitle" />

        <TextView
            android:id="@+id/pause_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/ash"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <Button
            android:id="@+id/button_resume"
            style="@style/Widget.ActionButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="@string/resume" />

        <Button
            android:id="@+id/button_pause_settings"
            style="@style/Widget.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/settings" />

        <Button
            android:id="@+id/button_pause_controller"
            style="@style/Widget.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/controller" />

        <Button
            android:id="@+id/button_quit"
            style="@style/Widget.ActionButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/quit_to_app" />
    </LinearLayout>
</FrameLayout>
