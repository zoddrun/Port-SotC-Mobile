<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black"
    android:orientation="vertical">

    <!--
        The editor preview occupies only the space above the control panel so
        that every on-screen control stays reachable. Overlaying the panel on a
        full-screen preview would hide the lower controls and make them
        impossible to select.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.portsotc.mobile.input.TouchControllerView
            android:id="@+id/editor_touch_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/scrim"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/editor_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/parchment"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIZE"
                android:textColor="@color/ash"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/editor_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPACITY"
                android:textColor="@color/ash"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/editor_alpha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/editor_hide"
                style="@style/Widget.ActionButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="HIDE" />

            <Button
                android:id="@+id/editor_reset"
                style="@style/Widget.ActionButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="RESET" />

            <Button
                android:id="@+id/editor_save"
                style="@style/Widget.ActionButton.Primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="SAVE" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
