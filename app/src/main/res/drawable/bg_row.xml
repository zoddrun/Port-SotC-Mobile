<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="6dp" />
            <solid android:color="#1B242C" />
            <stroke
                android:width="1dp"
                android:color="#4A5A64" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="6dp" />
            <solid android:color="#121820" />
            <stroke
                android:width="1dp"
                android:color="#26343C" />
        </shape>
    </item>
</selector>
