<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="4dp" />
            <solid android:color="#2A3035" />
            <stroke
                android:width="1dp"
                android:color="#3A4248" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="4dp" />
            <solid android:color="#E3D3A8" />
            <stroke
                android:width="1dp"
                android:color="#F0E4C4" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="4dp" />
            <solid android:color="#C9B27A" />
            <stroke
                android:width="1dp"
                android:color="#E3D3A8" />
        </shape>
    </item>
</selector>
