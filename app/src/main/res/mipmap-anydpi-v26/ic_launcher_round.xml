<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon derived from the developer-supplied artwork
     (icon/icon.png). Background and monochrome layers match the artwork;
     the foreground is inset so the content stays inside the 66dp safe
     zone under every launcher mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
