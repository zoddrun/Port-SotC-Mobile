<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        OpenGL ES 2.0 is the floor: the native host requests ES 3 and falls back
        to ES 2, and the recompiled runtime is built against raylib's ES 2
        backend. Requiring ES 3 here would hide the app from ES 2-only devices
        that can actually run it.
    -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <application
        android:name=".SotcApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.PortSotC">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ImportActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SettingsCategoryActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ControllerSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".TouchLayoutEditorActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.PortSotC.Fullscreen" />

        <!--
            Recompiled game runtime (D18). The library name must match the
            packaged artifact produced by tools/capture-host/build-android-runner.sh.
            raylib owns the window and frame loop in this activity.
        -->
        <activity
            android:name=".GameNativeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.PortSotC.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="ps2EntryRunner" />
        </activity>
    </application>

</manifest>
